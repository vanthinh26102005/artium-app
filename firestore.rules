  rules_version = '2';
  service cloud.firestore {
    match /databases/{database}/documents {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isEventOrganizer(eventId) {
        return (
          isSignedIn() &&
          get(/databases/$(database)/documents/events/$(eventId)).data.organizerId == request.auth.uid
        );
      }

      function isInvitedRsvp(eventId) {
        return request.resource.data.eventId == eventId
          && request.resource.data.status == "invited";
      }

      // Chỉ cho phép update các field liên quan follow counters
      function onlyFollowCountersChanged() {
        // changedKeys on nested maps returns top-level keys only (e.g., "stats"),
        // so we allow stats as a whole plus the top-level counters.
        let diffKeys = request.resource.data.diff(resource.data).changedKeys();
        return diffKeys.hasOnly([
          "followerCount",
          "followingCount",
          "stats",
        ]);
      }

      function onlyArtworkMetricsChanged() {
        let diffKeys = request.resource.data.diff(resource.data).changedKeys();
        return diffKeys.hasOnly(["metrics"]);
      }

      function invoicePaymentUnchanged() {
        let diffKeys = request.resource.data.diff(resource.data).changedKeys();
        return !diffKeys.hasAny(["payment"]);
      }

      function invoiceServerFieldsUnchanged() {
        let diffKeys = request.resource.data.diff(resource.data).changedKeys();
        return !diffKeys.hasAny(["isActive", "paidAt"]);
      }

      function invoiceStatusClientAllowed() {
        return request.resource.data.status in ["draft", "sent"];
      }

      // Allow public read on artworks, artists, events, and posts
      match /artworks/{artworkId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.artistId == request.auth.uid;
        allow update: if isSignedIn() && (resource.data.artistId == request.auth.uid || onlyArtworkMetricsChanged());
        allow delete: if isSignedIn() && resource.data.artistId == request.auth.uid;

        match /likes/{userId} {
          allow read: if true;
          allow create: if isSignedIn() && request.auth.uid == userId;
          allow delete: if isSignedIn() && (
            request.auth.uid == userId ||
            get(/databases/$(database)/documents/artworks/$(artworkId)).data.artistId == request.auth.uid
          );
        }
      }
      match /artists/{artistId} {
        allow read: if true;
        allow create, update: if isOwner(artistId);
        allow delete: if false;
      }

      match /auctions/{auctionId} {
        allow read: if true;
        // Giá đấu và người thắng phải do Cloud Functions/Admin SDK ghi
        // để client không tự sửa currentBid/topBidderId/endsAt.
        allow create, update, delete: if false;

        match /bids/{bidId} {
          allow read: if true;
          allow create, update, delete: if false;
        }
      }

      match /auctionDeposits/{depositId} {
        allow read: if isSignedIn() && (
          resource.data.bidderId == request.auth.uid ||
          get(/databases/$(database)/documents/auctions/$(resource.data.auctionId)).data.artistId == request.auth.uid
        );
        allow create, update, delete: if false;
      }

      match /editorials/{editorialId} {
        allow read: if true;
        allow write: if false; // No client-side writes allowed
      }
      match /events/{eventId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.organizerId == request.auth.uid;
        allow update: if isSignedIn()
          && resource.data.organizerId == request.auth.uid
          && request.resource.data.organizerId == resource.data.organizerId;
        allow delete: if isSignedIn() && resource.data.organizerId == request.auth.uid;
      }
      match /posts/{postId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if isSignedIn() && (
          resource.data.authorId == request.auth.uid ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true
        );

        // Allow any authenticated user to like/unlike
        // Also allow post author or admin to delete any like when deleting post
        match /likes/{userId} {
          allow read: if true;
          allow create: if request.auth != null && request.auth.uid == userId;
          allow delete: if request.auth != null && (
            request.auth.uid == userId ||
            get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true
          );
        }

        // Allow any authenticated user to comment
        // Also allow post author or admin to delete any comment when deleting post
        match /comments/{commentId} {
          allow read: if true;
          allow create: if request.auth != null;
          allow delete: if request.auth != null && (
            resource.data.author.id == request.auth.uid ||
            get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true
          );
        }
      }

      match /invoices/{invoiceId} {
        // Seller can read/delete their own invoices
        // Buyer can read invoices they created (where buyer.email matches)
        allow read: if isSignedIn() && (
          resource.data.sellerId == request.auth.uid ||
          resource.data.buyerId == request.auth.uid
        );
        allow delete: if isOwner(resource.data.sellerId);

        // Seller can create invoice (Quick Sell flow)
        // Any authenticated user can create invoice for a seller (Checkout flow)
        allow create: if isSignedIn()
          && request.resource.data.status in ["draft", "sent"]
          && request.resource.data.isActive == true
          && !request.resource.data.keys().hasAny(["payment"]);

        // Seller can update their invoices
        // Buyer can update invoices they created
        allow update: if isSignedIn()
          && (resource.data.sellerId == request.auth.uid || resource.data.buyerId == request.auth.uid)
          && request.resource.data.sellerId == resource.data.sellerId
          && invoicePaymentUnchanged()
          && invoiceServerFieldsUnchanged()
          && invoiceStatusClientAllowed();
      }

      // Chat Rules
      match /chats/{chatId} {
        // Cho phép đọc nếu document tồn tại và user là thành viên, 
        // HOẶC nếu user đang kiểm tra một chat ID có chứa UID của họ (để tạo mới)
        allow read: if isSignedIn() && (
          (resource != null && request.auth.uid in resource.data.participants) ||
          chatId.matches(".*" + request.auth.uid + ".*")
        );
        
        allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
        allow update: if isSignedIn() && request.auth.uid in resource.data.participants;
        
        match /messages/{messageId} {
          allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
          allow create: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        }
      }

      // Users can read their own data, and public profiles can be read by anyone
      match /users/{userId} {
        allow read: if true;
        allow create, delete: if isOwner(userId);
        allow update: if isOwner(userId) || (isSignedIn() && onlyFollowCountersChanged());

        // Explicitly allow access to event_rsvps subcollection
        match /event_rsvps/{rsvpId} {
          allow read: if true;
          allow create, update: if isOwner(userId) || (isEventOrganizer(rsvpId) && isInvitedRsvp(rsvpId));
          allow delete: if isOwner(userId);
        }

        // Allow users to follow each other
        match /followers/{followerId} {
          allow read: if true;
          allow write: if request.auth.uid == followerId;
        }

        match /following/{followingId} {
          allow read: if true;
          allow write: if request.auth.uid == userId;
        }

        // Moodboards
        match /moodboards/{boardId} {
          allow read, create, update, delete: if isOwner(userId);

          match /items/{itemId} {
            allow read, create, update, delete: if isOwner(userId);
          }
        }

        // Notifications - allow users to read/manage their own notifications
        match /notifications/{notificationId} {
          allow read: if isSignedIn() && request.auth.uid == userId;
          allow create, update, delete: if isSignedIn() && request.auth.uid == userId;
        }
      }

      // Allow collection group query for event_rsvps
      match /{path=**}/event_rsvps/{rsvpId} {
        allow read: if true;
      }
    }
  }
